{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "WreckfestController.Services.ServerControl.ServerManager": "Debug",
      "WreckfestController.Services.Tracking.PlayerTracker": "Information"
    }
  },
  "AllowedHosts": "*",
  "Api": {
    "Enabled": false,
    "Key": "",
    "AllowRemote": false,
    "TrustedProxies": [],
    "HttpPort": 5100,
    "HttpsPort": 5101
  },
  "UserSettingsPath": "%LocalAppData%\\WreckfestController\\user-settings.json",
  "WreckfestServer": {
    "SupportedBuild": "1.308438"
  },
  "Vote": {
    "Enabled": true,
    "Mode": "Voting",
    "DirectCooldownSeconds": 30,
    "SuppressCommandsDuringRace": false,
    "VoteTimeoutSeconds": 30,
    "MaxLapsAllowed": 10,
    "MessageDelayMs": 250
  }
}
