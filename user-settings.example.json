{
  "WreckfestServer": {
    "ServerPath": "<path-to-wreckfest-server>\\Wreckfest_x64.exe",
    "ServerArguments": "-s server_config=server_config.cfg",
    "WorkingDirectory": "<path-to-wreckfest-server>",
    "LogFilePath": "<path-to-wreckfest-server>\\log.txt",
    "UseConsoleMonitoring": true,
    "OutputMode": "ConsoleReader",
    "InputMode": "ConsoleWriter"
  },
  "SteamCmd": {
    "SteamCmdPath": "<path-to-steamcmd>\\steamcmd.exe",
    "WreckfestAppId": "361580"
  },
  "Webhooks": {
    "WebhookBaseUrl": "https://your-webhook-endpoint.example/api/webhooks",
    "WebhookApiKey": "your-64-character-hex-key-here"
  },
  "Vote": {
    "Enabled": true,
    "VoteTimeoutSeconds": 30,
    "MaxLapsAllowed": 10
  }
}
