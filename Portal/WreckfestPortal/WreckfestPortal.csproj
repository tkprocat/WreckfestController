<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The web site for one or more controllers: a front page listing the servers in its
    appsettings.json, with whether each is up and who is on it, and each controller's web
    app under /{id}/, whose API calls and live updates it forwards to that controller. It
    holds no account, key or database: signing in is between the browser and the controller.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14.0</LangVersion>
    <Version>2.0.0</Version>
    <RootNamespace>WreckfestPortal</RootNamespace>
    <!-- `dotnet publish` of the whole solution puts every project in one folder, with the
         controller's files. Publish the portal by its project. -->
    <IsPublishable Condition="'$(SolutionPath)' != '' And '$(SolutionPath)' != '*Undefined*'">false</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.11" />
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WreckfestPortal.Tests" />
  </ItemGroup>

  <!--
    Two builds of web/: the portal's page (`npm run build:portal`, web/dist-portal, copied
    to wwwroot) and the controllers' web app (`npm run build`, web/dist, copied to app/,
    which ControllerSite serves under each server's path). They share the theme and
    components. web/WebApp.targets installs the packages and runs every npm step under one
    lock. Inputs/Outputs make each build a no-op when nothing changed; MSBuild compares
    timestamps only, so two stamp files per build cover what that misses: the list of
    sources (one added or deleted) and the files the last build produced (one gone from
    its dist forces a rebuild). -p:SkipWebBuild=true skips both, and still copies whatever
    an earlier build left.
  -->
  <Import Project="..\..\web\WebApp.targets" />

  <PropertyGroup>
    <PortalWebDist>$(WebAppDir)\dist-portal</PortalWebDist>
    <PortalWebInputList>$(MSBuildProjectDirectory)\obj\portalweb.inputs</PortalWebInputList>
    <PortalWebOutputList>$(MSBuildProjectDirectory)\obj\portalweb.outputs</PortalWebOutputList>
    <WebAppDist>$(WebAppDir)\dist</WebAppDist>
    <WebAppInputList>$(MSBuildProjectDirectory)\obj\webapp.inputs</WebAppInputList>
    <WebAppOutputList>$(MSBuildProjectDirectory)\obj\webapp.outputs</WebAppOutputList>
  </PropertyGroup>

  <!-- The portal's page. -->

  <Target Name="RecordPortalWebInputs" Condition="'$(SkipWebBuild)' != 'true'">
    <WriteLinesToFile File="$(PortalWebInputList)" Lines="@(WebAppSource->'%(FullPath)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <Target Name="CheckPortalWebOutputs" Condition="'$(SkipWebBuild)' != 'true' And Exists('$(PortalWebOutputList)')">
    <ReadLinesFromFile File="$(PortalWebOutputList)">
      <Output TaskParameter="Lines" ItemName="RecordedPortalWebOutput" />
    </ReadLinesFromFile>
    <ItemGroup>
      <MissingPortalWebOutput Include="@(RecordedPortalWebOutput)" Condition="!Exists('%(Identity)')" />
    </ItemGroup>
    <Message Importance="high" Text="Portal page output is incomplete; rebuilding." Condition="'@(MissingPortalWebOutput)' != ''" />
    <Delete Files="$(PortalWebDist)\portal.html" Condition="'@(MissingPortalWebOutput)' != ''" />
  </Target>

  <Target Name="BuildPortalWeb" BeforeTargets="BeforeBuild"
          DependsOnTargets="InstallWebAppPackages;RecordPortalWebInputs;CheckPortalWebOutputs" Condition="'$(SkipWebBuild)' != 'true'"
          Inputs="@(WebAppSource);$(PortalWebInputList);$(WebAppInstalled)" Outputs="$(PortalWebDist)\portal.html">
    <Message Importance="high" Text="Building the portal page (npm run build:portal)..." />
    <Exec Command="node scripts/web-lock.mjs run build:portal" WorkingDirectory="$(WebAppDir)" />
  </Target>

  <Target Name="RecordPortalWebOutputs" AfterTargets="BuildPortalWeb" Condition="'$(SkipWebBuild)' != 'true' And Exists('$(PortalWebDist)\portal.html')">
    <ItemGroup>
      <ProducedPortalWebOutput Include="$(PortalWebDist)\**\*" />
    </ItemGroup>
    <WriteLinesToFile File="$(PortalWebOutputList)" Lines="@(ProducedPortalWebOutput->'%(FullPath)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <!-- The controllers' web app. -->

  <Target Name="RecordWebAppInputs" Condition="'$(SkipWebBuild)' != 'true'">
    <WriteLinesToFile File="$(WebAppInputList)" Lines="@(WebAppSource->'%(FullPath)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <Target Name="CheckWebAppOutputs" Condition="'$(SkipWebBuild)' != 'true' And Exists('$(WebAppOutputList)')">
    <ReadLinesFromFile File="$(WebAppOutputList)">
      <Output TaskParameter="Lines" ItemName="RecordedWebAppOutput" />
    </ReadLinesFromFile>
    <ItemGroup>
      <MissingWebAppOutput Include="@(RecordedWebAppOutput)" Condition="!Exists('%(Identity)')" />
    </ItemGroup>
    <Message Importance="high" Text="Web app output is incomplete; rebuilding." Condition="'@(MissingWebAppOutput)' != ''" />
    <Delete Files="$(WebAppDist)\index.html" Condition="'@(MissingWebAppOutput)' != ''" />
  </Target>

  <Target Name="BuildWebApp" BeforeTargets="BeforeBuild"
          DependsOnTargets="InstallWebAppPackages;RecordWebAppInputs;CheckWebAppOutputs" Condition="'$(SkipWebBuild)' != 'true'"
          Inputs="@(WebAppSource);$(WebAppInputList);$(WebAppInstalled)" Outputs="$(WebAppDist)\index.html">
    <Message Importance="high" Text="Building the web app (npm run build)..." />
    <Exec Command="node scripts/web-lock.mjs run build" WorkingDirectory="$(WebAppDir)" />
  </Target>

  <Target Name="RecordWebAppOutputs" AfterTargets="BuildWebApp" Condition="'$(SkipWebBuild)' != 'true' And Exists('$(WebAppDist)\index.html')">
    <ItemGroup>
      <ProducedWebAppOutput Include="$(WebAppDist)\**\*" />
    </ItemGroup>
    <WriteLinesToFile File="$(WebAppOutputList)" Lines="@(ProducedWebAppOutput->'%(FullPath)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <!-- Under the build lock, so neither copy reads a dist/ that the other build of this
       project is rewriting; each replaces its folder whole. -->
  <Target Name="CopyPortalWeb" AfterTargets="Build" Condition="Exists('$(PortalWebDist)') Or Exists('$(WebAppDist)')">
    <PropertyGroup>
      <!-- Absolute: the copies run in web/, where a relative OutDir would point elsewhere. -->
      <PortalOutDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(OutDir)'))</PortalOutDir>
    </PropertyGroup>
    <Exec Command="node scripts/web-lock.mjs copy dist-portal &quot;$(PortalOutDir)wwwroot&quot; portal.html" WorkingDirectory="$(WebAppDir)" />
    <Exec Command="node scripts/web-lock.mjs copy dist &quot;$(PortalOutDir)app&quot; index.html" WorkingDirectory="$(WebAppDir)" />
  </Target>

  <!-- AfterTargets runs even when Publish itself is skipped, hence IsPublishable here too. -->
  <Target Name="CopyPortalWebToPublish" AfterTargets="Publish" Condition="'$(PublishDir)' != '' And '$(IsPublishable)' != 'false'">
    <Error Condition="'$(SkipWebBuild)' != 'true' And !Exists('$(PortalWebDist)\portal.html')"
           Text="The portal page was not built at $(PortalWebDist). Refusing to publish the portal without it." />
    <Error Condition="'$(SkipWebBuild)' != 'true' And !Exists('$(WebAppDist)\index.html')"
           Text="The web app was not built at $(WebAppDist). Refusing to publish the portal without it." />
    <PropertyGroup>
      <PortalPublishDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(PublishDir)'))</PortalPublishDir>
    </PropertyGroup>
    <Exec Command="node scripts/web-lock.mjs copy dist-portal &quot;$(PortalPublishDir)wwwroot&quot; portal.html" WorkingDirectory="$(WebAppDir)" />
    <Exec Command="node scripts/web-lock.mjs copy dist &quot;$(PortalPublishDir)app&quot; index.html" WorkingDirectory="$(WebAppDir)" />
  </Target>

</Project>
