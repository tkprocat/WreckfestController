<UserControl x:Class="WreckfestController.Views.EventSchedulerTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{StaticResource BackgroundDark}">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel: Upcoming Events List -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                <materialDesign:PackIcon Kind="CalendarClock"
                                        Width="28"
                                        Height="28"
                                        Foreground="{StaticResource BlueColor}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,0"/>
                <TextBlock Text="Scheduled Events"
                          FontSize="20"
                          FontWeight="SemiBold"
                          Foreground="{StaticResource TextPrimary}"
                          VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Events DataGrid -->
            <DataGrid x:Name="EventsDataGrid"
                     Grid.Row="1"
                     AutoGenerateColumns="False"
                     IsReadOnly="True"
                     SelectionMode="Single"
                     CanUserAddRows="False"
                     CanUserDeleteRows="False"
                     CanUserResizeRows="False"
                     HeadersVisibility="Column"
                     GridLinesVisibility="Horizontal"
                     Background="{StaticResource BackgroundMedium}"
                     Foreground="{StaticResource TextPrimary}"
                     BorderBrush="{StaticResource BorderColor}"
                     BorderThickness="1"
                     SelectionChanged="OnEventSelected">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Event Name"
                                       Binding="{Binding Name}"
                                       Width="2*"/>

                    <DataGridTextColumn Header="Start Time"
                                       Binding="{Binding StartTime, StringFormat='yyyy-MM-dd HH:mm'}"
                                       Width="1.5*"/>

                    <DataGridTextColumn Header="Tracks"
                                       Binding="{Binding TrackCount}"
                                       Width="0.7*"/>

                    <DataGridTextColumn Header="Repeat"
                                       Binding="{Binding RepeatSchedule}"
                                       Width="1.5*"/>
                </DataGrid.Columns>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Setter Property="Background" Value="{StaticResource BackgroundMedium}"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2C5282"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>

            <!-- Refresh Button -->
            <Button x:Name="RefreshButton"
                   Grid.Row="2"
                   Style="{StaticResource MaterialDesignOutlinedButton}"
                   Foreground="{StaticResource BlueColor}"
                   BorderBrush="{StaticResource BlueColor}"
                   HorizontalAlignment="Right"
                   Margin="0,15,0,0"
                   Padding="20,8"
                   Click="OnRefreshClicked">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                        <TextBlock Text="REFRESH" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button.Content>
            </Button>
        </Grid>

        <!-- Right Panel: Event Details & Actions -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                <materialDesign:PackIcon Kind="InformationOutline"
                                        Width="28"
                                        Height="28"
                                        Foreground="{StaticResource BlueColor}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,0"/>
                <TextBlock Text="Event Details"
                          FontSize="20"
                          FontWeight="SemiBold"
                          Foreground="{StaticResource TextPrimary}"
                          VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Event Details Panel -->
            <ScrollViewer Grid.Row="1"
                         VerticalScrollBarVisibility="Auto"
                         Background="{StaticResource BackgroundMedium}"
                         Padding="20"
                         Margin="0,0,0,15">
                <StackPanel x:Name="EventDetailsPanel">
                    <TextBlock x:Name="NoSelectionText"
                              Text="Select an event to view details"
                              Foreground="{StaticResource TextSecondary}"
                              FontStyle="Italic"
                              TextAlignment="Center"
                              Margin="0,20"/>

                    <StackPanel x:Name="DetailsContent" Visibility="Collapsed">
                        <!-- Event Name -->
                        <TextBlock Text="Event Name"
                                  Foreground="{StaticResource TextSecondary}"
                                  FontSize="11"
                                  Margin="0,0,0,5"/>
                        <TextBox x:Name="EventNameText"
                                Foreground="{StaticResource TextPrimary}"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Margin="0,0,0,15"
                                TextWrapping="Wrap"
                                Background="Transparent"
                                BorderThickness="0"
                                IsReadOnly="True"
                                IsTabStop="False"
                                Cursor="Arrow"/>

                        <!-- Start Time -->
                        <TextBlock Text="Start Time"
                                  Foreground="{StaticResource TextSecondary}"
                                  FontSize="11"
                                  Margin="0,0,0,5"/>
                        <TextBox x:Name="StartTimeText"
                                Foreground="{StaticResource TextPrimary}"
                                FontSize="14"
                                Margin="0,0,0,15"
                                Background="Transparent"
                                BorderThickness="0"
                                IsReadOnly="True"
                                IsTabStop="False"
                                Cursor="Arrow"/>

                        <!-- Server Config -->
                        <TextBlock Text="Server Name"
                                  Foreground="{StaticResource TextSecondary}"
                                  FontSize="11"
                                  Margin="0,0,0,5"/>
                        <TextBox x:Name="ServerNameText"
                                Foreground="{StaticResource TextPrimary}"
                                FontSize="14"
                                Margin="0,0,0,15"
                                TextWrapping="Wrap"
                                Background="Transparent"
                                BorderThickness="0"
                                IsReadOnly="True"
                                IsTabStop="False"
                                Cursor="Arrow"/>

                        <!-- Tracks -->
                        <TextBlock Text="Track Rotation"
                                  Foreground="{StaticResource TextSecondary}"
                                  FontSize="11"
                                  Margin="0,0,0,5"/>
                        <TextBox x:Name="TracksText"
                                Foreground="{StaticResource TextPrimary}"
                                FontSize="12"
                                Margin="0,0,0,15"
                                TextWrapping="Wrap"
                                Background="Transparent"
                                BorderThickness="0"
                                IsReadOnly="True"
                                IsTabStop="False"
                                Cursor="Arrow"/>

                        <!-- Recurring Pattern -->
                        <TextBlock Text="Recurring Pattern"
                                  Foreground="{StaticResource TextSecondary}"
                                  FontSize="11"
                                  Margin="0,0,0,5"/>
                        <TextBox x:Name="RecurringText"
                                Foreground="{StaticResource TextPrimary}"
                                FontSize="14"
                                Margin="0,0,0,15"
                                TextWrapping="Wrap"
                                Background="Transparent"
                                BorderThickness="0"
                                IsReadOnly="True"
                                IsTabStop="False"
                                Cursor="Arrow"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Activate Button -->
            <Button x:Name="ActivateButton"
                   Grid.Row="2"
                   Style="{StaticResource MaterialDesignRaisedButton}"
                   Background="{StaticResource ButtonOrange}"
                   Foreground="White"
                   HorizontalAlignment="Stretch"
                   MinHeight="44"
                   Padding="20,14"
                   FontWeight="SemiBold"
                   IsEnabled="False"
                   Click="OnActivateClicked">
                <Button.Content>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="PlayCircleOutline"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               Width="20"
                                               Height="20"/>
                        <TextBlock Text="ACTIVATE NOW" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button.Content>
            </Button>
        </Grid>
    </Grid>
</UserControl>
