<UserControl x:Class="WreckfestController.Views.ControllerLogTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{StaticResource BackgroundDark}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <materialDesign:PackIcon Kind="TextBox"
                                    Width="24"
                                    Height="24"
                                    Foreground="{StaticResource BlueColor}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0"/>
            <TextBlock Text="Controller Log"
                      FontSize="16"
                      FontWeight="Bold"
                      Foreground="{StaticResource TextPrimary}"
                      VerticalAlignment="Center"/>
            <TextBlock x:Name="LogCountText"
                      Text="(0 entries)"
                      FontSize="12"
                      Foreground="{StaticResource TextSecondary}"
                      VerticalAlignment="Center"
                      Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Log Display -->
        <Border Grid.Row="1"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                Background="{StaticResource BackgroundMedium}">
            <ScrollViewer x:Name="LogScrollView"
                         VerticalScrollBarVisibility="Auto"
                         Padding="10">
                <ItemsControl x:Name="LogContainer">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,5"
                                   Margin="0,2"
                                   Background="{StaticResource BackgroundDark}"
                                   BorderBrush="{StaticResource BorderColor}"
                                   BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Timestamp -->
                                    <TextBox Grid.Column="0"
                                            Text="{Binding Timestamp, Mode=OneWay}"
                                            FontSize="10"
                                            FontFamily="Consolas"
                                            Foreground="{StaticResource TextSecondary}"
                                            VerticalAlignment="Top"
                                            Margin="0,0,10,0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            IsReadOnly="True"
                                            IsTabStop="False"
                                            Cursor="Arrow"/>

                                    <!-- Level Badge -->
                                    <Border Grid.Column="1"
                                           Background="{Binding LevelColor}"
                                           CornerRadius="3"
                                           Padding="6,2"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Top">
                                        <TextBox Text="{Binding Level, Mode=OneWay}"
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                IsReadOnly="True"
                                                IsTabStop="False"
                                                Cursor="Arrow"/>
                                    </Border>

                                    <!-- Message -->
                                    <TextBox Grid.Column="2"
                                            Text="{Binding Message, Mode=OneWay}"
                                            FontSize="12"
                                            Foreground="{StaticResource TextPrimary}"
                                            TextWrapping="Wrap"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            IsReadOnly="True"
                                            IsTabStop="False"
                                            Cursor="Arrow"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Controls -->
        <StackPanel Grid.Row="2"
                   Orientation="Horizontal"
                   HorizontalAlignment="Right"
                   Margin="0,10,0,0">
            <!-- Auto-scroll checkbox -->
            <CheckBox x:Name="AutoScrollCheckBox"
                     Content="Auto-scroll"
                     IsChecked="True"
                     Foreground="{StaticResource TextPrimary}"
                     VerticalAlignment="Center"
                     Margin="0,0,15,0"/>

            <!-- Clear button -->
            <Button Content="CLEAR LOG"
                   Background="{StaticResource BorderColor}"
                   Foreground="White"
                   Click="OnClearLogClicked"
                   Padding="15,8"
                   FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</UserControl>
