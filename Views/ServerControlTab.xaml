<UserControl x:Class="WreckfestController.Views.ServerControlTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Background="{StaticResource BackgroundDark}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Server Status Panel -->
            <RowDefinition Height="*"/>    <!-- Console/Event Log -->
            <RowDefinition Height="Auto"/> <!-- Command Input -->
        </Grid.RowDefinitions>

        <!-- Server Status Panel -->
        <Border Grid.Row="0"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                Padding="10"
                Margin="10,10,10,10"
                Background="{StaticResource BackgroundMedium}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Server Status -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Server Status" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                    <TextBlock x:Name="ServerStatusLabel" Text="Stopped" FontSize="16" FontWeight="Bold" Foreground="{StaticResource RedColor}" />
                </StackPanel>

                <!-- Player Count -->
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="Players" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                    <TextBlock x:Name="PlayerCountLabel" Text="0 / 24" FontSize="16" FontWeight="Bold" Foreground="{StaticResource GreenColor}" />
                </StackPanel>

                <!-- Current Track -->
                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="Current Track" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                    <TextBlock x:Name="CurrentTrackLabel" Text="None" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BlueColor}" />
                </StackPanel>

                <!-- Uptime -->
                <StackPanel Grid.Column="3" Margin="0,0,10,0">
                    <TextBlock Text="Uptime" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                    <TextBlock x:Name="UptimeLabel" Text="00:00:00" FontSize="16" FontWeight="Bold" Foreground="{StaticResource YellowColor}" />
                </StackPanel>

                <!-- Control Buttons -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="StartButton"
                            Content="START"
                            Background="{StaticResource ButtonGreen}"
                            Foreground="White"
                            Click="OnStartClicked"
                            Width="80" Margin="0,0,10,0"/>
                    <Button x:Name="StopButton"
                            Content="STOP"
                            Background="{StaticResource ButtonRed}"
                            Foreground="White"
                            Click="OnStopClicked"
                            Width="80" Margin="0,0,10,0"
                            IsEnabled="False"/>
                    <Button x:Name="RestartButton"
                            Content="RESTART"
                            Background="{StaticResource ButtonOrange}"
                            Foreground="White"
                            Click="OnRestartClicked"
                            Width="90"
                            IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Console Mirror and Event Log -->
        <Grid Grid.Row="1" Margin="10,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Console Mirror Panel (Left Side) -->
            <Border Grid.Column="0"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1"
                    Background="{StaticResource BackgroundDark}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="Server Console Output"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"
                               Margin="0,0,0,10" />

                    <ScrollViewer Grid.Row="1" x:Name="ConsoleScrollView"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                        <TextBlock x:Name="ConsoleOutput"
                                   FontFamily="Consolas,Courier New"
                                   FontSize="12"
                                   Foreground="{StaticResource TextPrimary}"
                                   TextWrapping="NoWrap"
                                   Text="Waiting for server to start..." />
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Event Log Panel (Right Side) -->
            <Border Grid.Column="2"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1"
                    Background="{StaticResource BackgroundMedium}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="Event Log"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"
                               Margin="0,0,0,10" />

                    <ScrollViewer Grid.Row="1" x:Name="EventLogScrollView"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="EventLogContainer">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,5" Margin="0,2"
                                            Background="{StaticResource BackgroundDark}">
                                        <StackPanel>
                                            <TextBox Text="{Binding Timestamp, Mode=OneWay}"
                                                    FontSize="10"
                                                    Foreground="{StaticResource TextSecondary}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    IsReadOnly="True"
                                                    IsTabStop="False"
                                                    Cursor="Arrow"/>
                                            <TextBox Text="{Binding Message, Mode=OneWay}"
                                                    FontSize="12"
                                                    Foreground="{Binding Color}"
                                                    TextWrapping="Wrap"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    IsReadOnly="True"
                                                    IsTabStop="False"
                                                    Cursor="Arrow"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Grid.Row="2"
                            Content="Clear Log"
                            Background="{StaticResource BorderColor}"
                            Foreground="White"
                            Click="OnClearEventLogClicked"
                            Margin="0,10,0,0"
                            Padding="5"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Command Input Panel -->
        <Border Grid.Row="2"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                Padding="10"
                Margin="10,0,10,10"
                Background="{StaticResource BackgroundMedium}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="CommandInput"
                         Grid.Column="0"
                         Background="{StaticResource BackgroundDark}"
                         Foreground="{StaticResource TextPrimary}"
                         BorderBrush="{StaticResource BorderColor}"
                         Padding="5"
                         VerticalContentAlignment="Center"
                         KeyDown="OnCommandKeyDown"/>
                <Button Grid.Column="1"
                        Content="Send"
                        Background="{StaticResource ButtonGreen}"
                        Foreground="White"
                        Click="OnCommandSubmitted"
                        Margin="10,0,0,0"
                        Width="100"
                        Padding="5"
                        FontWeight="Bold"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
