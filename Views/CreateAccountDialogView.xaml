<UserControl x:Class="WreckfestController.Views.CreateAccountDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Border Background="{StaticResource BackgroundDark}"
            BorderBrush="{StaticResource BorderColor}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="0"
            Width="460">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="{StaticResource BackgroundMedium}"
                    CornerRadius="8,8,0,0"
                    Padding="20,15">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AccountPlus"
                                             Width="24"
                                             Height="24"
                                             Foreground="#1E88E5"
                                             VerticalAlignment="Center"
                                             Margin="0,0,15,0"/>
                    <TextBlock Text="Create admin account"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Content -->
            <StackPanel Grid.Row="1" Margin="20">
                <TextBlock x:Name="IntroText"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondary}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,15"/>

                <TextBox x:Name="UserNameTextBox"
                         materialDesign:HintAssist.Hint="Username"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Foreground="{StaticResource TextPrimary}"
                         Margin="0,0,0,10"/>
                <TextBox x:Name="EmailTextBox"
                         materialDesign:HintAssist.Hint="Email"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Foreground="{StaticResource TextPrimary}"
                         Margin="0,0,0,10"/>
                <PasswordBox x:Name="PasswordBox"
                             materialDesign:HintAssist.Hint="Password (at least 10 characters)"
                             Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                             Foreground="{StaticResource TextPrimary}"
                             Margin="0,0,0,10"/>
                <PasswordBox x:Name="ConfirmPasswordBox"
                             materialDesign:HintAssist.Hint="Confirm password"
                             Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                             Foreground="{StaticResource TextPrimary}"/>

                <TextBlock x:Name="ErrorText"
                           Foreground="#E53935"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="2"
                    Background="{StaticResource BackgroundMedium}"
                    CornerRadius="0,0,8,8"
                    Padding="20,15">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="CancelButton"
                            Content="LATER"
                            Click="OnCancelClicked"
                            Background="{StaticResource BackgroundDark}"
                            Foreground="{StaticResource TextPrimary}"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="1"
                            Width="100"
                            Margin="0,0,10,0"/>
                    <Button x:Name="CreateButton"
                            Content="CREATE"
                            Click="OnCreateClicked"
                            IsDefault="True"
                            Background="{StaticResource ButtonLightBlue}"
                            Foreground="White"
                            Width="100"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
