<UserControl x:Class="WreckfestController.Views.PlayersTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Background="{StaticResource BackgroundDark}" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource BackgroundMedium}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="15"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="ONLINE PLAYERS"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock x:Name="PlayerCountText"
                               Text="0 players online (0 bots)"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="REFRESH"
                        Background="{StaticResource ButtonLightBlue}"
                        Foreground="White"
                        Click="OnRefreshClicked"
                        Width="100"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Players List -->
        <Border Grid.Row="1"
                Background="{StaticResource BackgroundMedium}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PlayersContainer" Margin="10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BackgroundDark}"
                                    BorderBrush="{StaticResource BorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="15"
                                    Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Status Indicator -->
                                    <Border Grid.Column="0"
                                            Width="10"
                                            Height="10"
                                            CornerRadius="5"
                                            Background="{Binding StatusColor}"
                                            VerticalAlignment="Center"
                                            Margin="0,0,15,0"/>

                                    <!-- Player Info -->
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock Text=" [ADMIN]"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource ButtonOrange}"
                                                       Visibility="{Binding IsAdminVisible}"
                                                       Margin="5,0,0,0"/>
                                            <TextBlock Text=" [BOT]"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       Visibility="{Binding IsBotVisible}"
                                                       Margin="5,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding SlotInfo}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Join Time and Actions -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding JoinTimeText}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,15,0"/>

                                        <!-- Action Buttons -->
                                        <Button Content="Promote"
                                                Background="{StaticResource ButtonGreen}"
                                                Foreground="White"
                                                FontSize="10"
                                                Padding="8,4"
                                                Margin="0,0,5,0"
                                                Click="OnPromoteClicked"
                                                Tag="{Binding Slot}"
                                                Visibility="{Binding CanPromoteVisible}"/>
                                        <Button Content="Demote"
                                                Background="{StaticResource ButtonOrange}"
                                                Foreground="White"
                                                FontSize="10"
                                                Padding="8,4"
                                                Margin="0,0,5,0"
                                                Click="OnDemoteClicked"
                                                Tag="{Binding Slot}"
                                                Visibility="{Binding CanDemoteVisible}"/>
                                        <Button Content="Kick"
                                                Background="{StaticResource ButtonRed}"
                                                Foreground="White"
                                                FontSize="10"
                                                Padding="8,4"
                                                Margin="0,0,5,0"
                                                Click="OnKickClicked"
                                                Tag="{Binding Slot}"
                                                Visibility="{Binding CanKickVisible}"/>
                                        <Button Content="Ban"
                                                Background="#8B0000"
                                                Foreground="White"
                                                FontSize="10"
                                                Padding="8,4"
                                                Click="OnBanClicked"
                                                Tag="{Binding Slot}"
                                                Visibility="{Binding CanBanVisible}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
