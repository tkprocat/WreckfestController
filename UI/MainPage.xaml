<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WreckfestController.UI.MainPage"
             Title="Wreckfest Server Console">

    <Grid Padding="10" RowDefinitions="Auto,*,Auto">

        <!-- Server Status Panel -->
        <Border Grid.Row="0"
                Stroke="#555555"
                StrokeThickness="1"
                Padding="10"
                Margin="0,0,0,10"
                BackgroundColor="#1E1E1E">
            <Grid ColumnDefinitions="*,*,*,*,*" RowDefinitions="Auto,Auto">

                <!-- Server Status -->
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="Server Status" FontSize="12" TextColor="#888888" />
                    <Label x:Name="ServerStatusLabel" Text="Stopped" FontSize="16" FontAttributes="Bold" TextColor="#FF6B6B" />
                </VerticalStackLayout>

                <!-- Player Count -->
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="Players" FontSize="12" TextColor="#888888" />
                    <Label x:Name="PlayerCountLabel" Text="0 / 24" FontSize="16" FontAttributes="Bold" TextColor="#51CF66" />
                </VerticalStackLayout>

                <!-- Current Track -->
                <VerticalStackLayout Grid.Column="2">
                    <Label Text="Current Track" FontSize="12" TextColor="#888888" />
                    <Label x:Name="CurrentTrackLabel" Text="None" FontSize="16" FontAttributes="Bold" TextColor="#74C0FC" />
                </VerticalStackLayout>

                <!-- Uptime -->
                <VerticalStackLayout Grid.Column="3">
                    <Label Text="Uptime" FontSize="12" TextColor="#888888" />
                    <Label x:Name="UptimeLabel" Text="00:00:00" FontSize="16" FontAttributes="Bold" TextColor="#FFD43B" />
                </VerticalStackLayout>

                <!-- Control Buttons -->
                <HorizontalStackLayout Grid.Column="4" Spacing="10" VerticalOptions="Center">
                    <Button x:Name="StartButton"
                            Text="Start"
                            BackgroundColor="#51CF66"
                            TextColor="White"
                            Clicked="OnStartClicked"
                            WidthRequest="80" />
                    <Button x:Name="StopButton"
                            Text="Stop"
                            BackgroundColor="#FF6B6B"
                            TextColor="White"
                            Clicked="OnStopClicked"
                            WidthRequest="80"
                            IsEnabled="False" />
                    <Button x:Name="RestartButton"
                            Text="Restart"
                            BackgroundColor="#FFD43B"
                            TextColor="Black"
                            Clicked="OnRestartClicked"
                            WidthRequest="80"
                            IsEnabled="False" />
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <!-- Main Content Area: Console Mirror + Event Log -->
        <Grid Grid.Row="1" ColumnDefinitions="2*,*" ColumnSpacing="10">

            <!-- Console Mirror Panel (Left Side) -->
            <Border Grid.Column="0"
                    Stroke="#555555"
                    StrokeThickness="1"
                    BackgroundColor="#0D1117">
                <Grid Padding="10" RowDefinitions="Auto,*">
                    <Label Grid.Row="0"
                           Text="Server Console Output"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#C9D1D9"
                           Margin="0,0,0,10" />

                    <ScrollView Grid.Row="1" x:Name="ConsoleScrollView">
                        <Label x:Name="ConsoleOutput"
                               FontFamily="Consolas,Courier New,monospace"
                               FontSize="12"
                               TextColor="#C9D1D9"
                               LineBreakMode="NoWrap"
                               Text="Waiting for server to start..." />
                    </ScrollView>
                </Grid>
            </Border>

            <!-- Event Log Panel (Right Side) -->
            <Border Grid.Column="1"
                    Stroke="#555555"
                    StrokeThickness="1"
                    BackgroundColor="#1E1E1E">
                <Grid Padding="10" RowDefinitions="Auto,*,Auto">
                    <Label Grid.Row="0"
                           Text="Event Log"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#C9D1D9"
                           Margin="0,0,0,10" />

                    <ScrollView Grid.Row="1" x:Name="EventLogScrollView">
                        <VerticalStackLayout x:Name="EventLogContainer" Spacing="5">
                            <!-- Event log items will be added here dynamically -->
                        </VerticalStackLayout>
                    </ScrollView>

                    <Button Grid.Row="2"
                            Text="Clear Log"
                            BackgroundColor="#555555"
                            TextColor="White"
                            Clicked="OnClearEventLogClicked"
                            Margin="0,10,0,0" />
                </Grid>
            </Border>
        </Grid>

        <!-- Command Input Panel -->
        <Border Grid.Row="2"
                Stroke="#555555"
                StrokeThickness="1"
                Padding="10"
                Margin="0,10,0,0"
                BackgroundColor="#1E1E1E">
            <Grid ColumnDefinitions="*,Auto">
                <Entry x:Name="CommandInput"
                       Grid.Column="0"
                       Placeholder="Enter server command..."
                       PlaceholderColor="#888888"
                       TextColor="#C9D1D9"
                       BackgroundColor="#0D1117"
                       Completed="OnCommandSubmitted" />
                <Button Grid.Column="1"
                        Text="Send"
                        BackgroundColor="#238636"
                        TextColor="White"
                        Clicked="OnCommandSubmitted"
                        Margin="10,0,0,0"
                        WidthRequest="100" />
            </Grid>
        </Border>

    </Grid>

</ContentPage>
