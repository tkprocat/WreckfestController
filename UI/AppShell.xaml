<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:WreckfestController.UI"
       x:Class="WreckfestController.UI.AppShell">

    <TabBar>
        <ShellContent Title="Server Console"
                      ContentTemplate="{DataTemplate local:MainPage}"
                      Icon="console.png" />

        <ShellContent Title="Configuration"
                      ContentTemplate="{DataTemplate local:ConfigurationPage}"
                      Icon="settings.png" />

        <ShellContent Title="Events"
                      ContentTemplate="{DataTemplate local:EventsPage}"
                      Icon="calendar.png" />
    </TabBar>

</Shell>
