<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <LangVersion>14.0</LangVersion>

    <!-- Disable auto-generated Main method from App.xaml -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>

    <!-- Application info -->
    <ApplicationTitle>Wreckfest Controller</ApplicationTitle>
    <Version>2.0.0</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
    <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
    <Deterministic>false</Deterministic>

    <!-- Single-file, framework-dependent publishing configuration -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <!-- Release configuration: exclude debug symbols and unnecessary files -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- The web app has its own build (see BuildWebApp); its thousands of node_modules
       files must not become project items. -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);web/**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Disable OpenAPI document generation during build -->
  <PropertyGroup>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows Services support -->
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.11" />

    <!-- System packages -->
    <PackageReference Include="System.Management" Version="10.0.11" />

    <!-- Database: SQLite through EF Core, with ASP.NET Core Identity's user store -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Framework references for ASP.NET Core -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="WreckfestController.Tests\**" />
    <Content Remove="WreckfestController.Tests\**" />
    <EmbeddedResource Remove="WreckfestController.Tests\**" />
    <None Remove="WreckfestController.Tests\**" />
  </ItemGroup>

  <!-- Exclude old MAUI files and directories -->
  <ItemGroup>
    <Compile Remove="UI\**" />
    <Compile Remove="Resources\**" />
    <Compile Remove="Platforms\**" />
    <EmbeddedResource Remove="UI\**" />
    <EmbeddedResource Remove="Resources\**" />
    <EmbeddedResource Remove="Platforms\**" />
    <None Remove="UI\**" />
    <None Remove="Resources\**" />
    <None Remove="Platforms\**" />
    <Page Remove="UI\**" />
    <Page Remove="Resources\**" />
    <Page Remove="Platforms\**" />
  </ItemGroup>

  <!-- Include appsettings.json so published installs retain default vote tracks. -->
  <ItemGroup>
    <Content Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Update="appsettings.example.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Update="appsettings.example.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>

  <!-- Auto-generate version based on build date -->
  <Target Name="GenerateVersionInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <BuildDate>$([System.DateTime]::UtcNow.ToString("yyyy.MMdd.HHmm"))</BuildDate>
      <!-- Major.minor of $(Version), the one place the version is set. -->
      <VersionPrefix>$([System.Version]::Parse('$(Version)').ToString(2))</VersionPrefix>
    </PropertyGroup>

    <ItemGroup>
      <AssemblyAttributes Include="AssemblyVersion">
        <_Parameter1>$(VersionPrefix).0.0</_Parameter1>
      </AssemblyAttributes>
      <AssemblyAttributes Include="AssemblyFileVersion">
        <_Parameter1>$(BuildDate)</_Parameter1>
      </AssemblyAttributes>
      <AssemblyAttributes Include="AssemblyInformationalVersion">
        <_Parameter1>$(VersionPrefix).$(BuildDate)</_Parameter1>
      </AssemblyAttributes>
      <!-- The full version, patch included, for the desktop app's About tab. -->
      <AssemblyAttributes Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>AppVersion</_Parameter1>
        <_Parameter2>$(Version)</_Parameter2>
      </AssemblyAttributes>
    </ItemGroup>

    <WriteCodeFragment Language="C#" OutputFile="$(IntermediateOutputPath)VersionInfo.cs" AssemblyAttributes="@(AssemblyAttributes)" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)VersionInfo.cs" />
    </ItemGroup>
  </Target>

  <PropertyGroup>
    <NativeHookDir>$(MSBuildProjectDirectory)\NativeHooks\WreckfestConsoleHook</NativeHookDir>
    <NativeHookProject>$(NativeHookDir)\WreckfestConsoleHook.vcxproj</NativeHookProject>
    <NativeHookDll>$(NativeHookDir)\bin\$(Configuration)\WreckfestConsoleHook.dll</NativeHookDll>
    <VsWherePath>$(MSBuildProgramFiles32)\Microsoft Visual Studio\Installer\vswhere.exe</VsWherePath>
  </PropertyGroup>

  <ItemGroup>
    <NativeHookSource Include="$(NativeHookDir)\WreckfestConsoleHook.cpp" />
    <NativeHookSource Include="$(NativeHookProject)" />
    <NativeHookSource Include="$(NativeHookDir)\third_party\minhook\**\*.c" />
    <NativeHookSource Include="$(NativeHookDir)\third_party\minhook\**\*.h" />
  </ItemGroup>

  <!--
    The injected hook is a C++ DLL. The .NET SDK does not ship the C++ MSBuild
    targets, so `dotnet build` cannot import a .vcxproj directly - a plain
    ProjectReference fails with MSB4278 and takes the whole C# build down with it.
    Locating full MSBuild and shelling out keeps `dotnet build` and `dotnet test`
    working while still producing the DLL automatically.

    Inputs/Outputs make this a no-op once the DLL is newer than its sources, so
    the common case costs nothing.
  -->
  <Target Name="BuildWreckfestConsoleHook" BeforeTargets="BeforeBuild"
          Inputs="@(NativeHookSource)" Outputs="$(NativeHookDll)">
    <Error Condition="!Exists('$(VsWherePath)')"
           Text="Cannot build the native console hook: vswhere.exe not found at $(VsWherePath). Visual Studio with the Desktop development with C++ workload is required." />

    <Exec Command="&quot;$(VsWherePath)&quot; -latest -requires Microsoft.Component.MSBuild -find MSBuild\**\Bin\MSBuild.exe"
          ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="FullMSBuildPath" />
    </Exec>

    <Error Condition="'$(FullMSBuildPath)' == '' Or !Exists('$(FullMSBuildPath)')"
           Text="Cannot build the native console hook: MSBuild.exe was not found. Install the Desktop development with C++ workload in Visual Studio." />

    <Message Importance="high" Text="Building native console hook ($(Configuration)|x64)..." />
    <Exec Command="&quot;$(FullMSBuildPath)&quot; &quot;$(NativeHookProject)&quot; -p:Configuration=$(Configuration) -p:Platform=x64 -v:minimal -nologo" />
  </Target>

  <Target Name="CopyWreckfestConsoleHook" AfterTargets="Build">
    <!-- Fail loudly. Silently skipping produced an app that launched fine and
         could never inject, with no error anywhere. -->
    <Error Condition="!Exists('$(NativeHookDll)')"
           Text="The native console hook DLL was not produced at $(NativeHookDll). The application cannot inject without it." />
    <Copy SourceFiles="$(NativeHookDll)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyWreckfestConsoleHookToPublish" AfterTargets="Publish">
    <Error Condition="!Exists('$(NativeHookDll)')"
           Text="The native console hook DLL was not produced at $(NativeHookDll). Refusing to publish an application that cannot inject." />
    <Copy SourceFiles="$(NativeHookDll)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="'$(PublishDir)' != ''" />
  </Target>

  <!--
    The web app (web/, Vue + Vite). Built with npm into web/dist, then copied to
    wwwroot next to the exe, where ApiServer serves it. Node.js LTS is a build
    requirement like the C++ workload; -p:SkipWebBuild=true builds the C# alone, and
    still copies whatever web/dist an earlier build left (none: the API alone).

    Inputs/Outputs make both steps no-ops when nothing changed: npm ci only when
    package.json or the lockfile is newer than the installed packages, the build only
    when a source is newer than dist/index.html. MSBuild compares timestamps only, so
    two stamp files cover what that misses: the list of sources (a deleted or added
    file changes it) and the list of files the last build produced (one gone from dist
    forces a rebuild).
  -->
  <PropertyGroup>
    <WebAppDir>$(MSBuildProjectDirectory)\web</WebAppDir>
    <WebAppDist>$(WebAppDir)\dist</WebAppDist>
    <WebAppLock>$(WebAppDir)\package-lock.json</WebAppLock>
    <WebAppInstalled>$(WebAppDir)\node_modules\.wfc-installed</WebAppInstalled>
    <WebAppInputList>$(MSBuildProjectDirectory)\obj\webapp.inputs</WebAppInputList>
    <WebAppOutputList>$(MSBuildProjectDirectory)\obj\webapp.outputs</WebAppOutputList>
  </PropertyGroup>

  <ItemGroup>
    <WebAppSource Include="$(WebAppDir)\src\**\*" />
    <WebAppSource Include="$(WebAppDir)\public\**\*" />
    <WebAppSource Include="$(WebAppDir)\index.html;$(WebAppDir)\package.json;$(WebAppLock);$(WebAppDir)\vite.config.ts;$(WebAppDir)\tsconfig*.json" />
  </ItemGroup>

  <Target Name="CheckNodeForWebApp" Condition="'$(SkipWebBuild)' != 'true'">
    <Exec Command="node --version" ContinueOnError="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="NodeExitCode" />
    </Exec>
    <Error Condition="'$(NodeExitCode)' != '0'"
           Text="Cannot build the web app: Node.js was not found on PATH. Install Node.js LTS, or build with -p:SkipWebBuild=true for C#-only work." />
  </Target>

  <Target Name="InstallWebAppPackages" DependsOnTargets="CheckNodeForWebApp" Condition="'$(SkipWebBuild)' != 'true'"
          Inputs="$(WebAppDir)\package.json;$(WebAppLock)" Outputs="$(WebAppInstalled)">
    <Message Importance="high" Text="Installing web app packages (npm ci)..." />
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(WebAppDir)" />
    <!-- npm's own marker files keep old timestamps, so this target keeps its own. -->
    <Touch Files="$(WebAppInstalled)" AlwaysCreate="true" />
  </Target>

  <!-- Rewritten only when the list differs, so its timestamp moves only then. -->
  <Target Name="RecordWebAppInputs" Condition="'$(SkipWebBuild)' != 'true'">
    <WriteLinesToFile File="$(WebAppInputList)" Lines="@(WebAppSource->'%(FullPath)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <!-- A file the last build produced is missing from dist: build again. -->
  <Target Name="CheckWebAppOutputs" Condition="'$(SkipWebBuild)' != 'true' And Exists('$(WebAppOutputList)')">
    <ReadLinesFromFile File="$(WebAppOutputList)">
      <Output TaskParameter="Lines" ItemName="RecordedWebAppOutput" />
    </ReadLinesFromFile>
    <ItemGroup>
      <MissingWebAppOutput Include="@(RecordedWebAppOutput)" Condition="!Exists('%(Identity)')" />
    </ItemGroup>
    <Message Importance="high" Text="Web app output is incomplete; rebuilding." Condition="'@(MissingWebAppOutput)' != ''" />
    <Delete Files="$(WebAppDist)\index.html" Condition="'@(MissingWebAppOutput)' != ''" />
  </Target>

  <Target Name="BuildWebApp" BeforeTargets="BeforeBuild"
          DependsOnTargets="InstallWebAppPackages;RecordWebAppInputs;CheckWebAppOutputs" Condition="'$(SkipWebBuild)' != 'true'"
          Inputs="@(WebAppSource);$(WebAppInputList);$(WebAppInstalled)" Outputs="$(WebAppDist)\index.html">
    <Message Importance="high" Text="Building web app (npm run build)..." />
    <Exec Command="npm run build" WorkingDirectory="$(WebAppDir)" />
  </Target>

  <Target Name="RecordWebAppOutputs" AfterTargets="BuildWebApp" Condition="'$(SkipWebBuild)' != 'true' And Exists('$(WebAppDist)\index.html')">
    <ItemGroup>
      <ProducedWebAppOutput Include="$(WebAppDist)\**\*" />
    </ItemGroup>
    <WriteLinesToFile File="$(WebAppOutputList)" Lines="@(ProducedWebAppOutput->'%(FullPath)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <!-- Replaces wwwroot whole, so assets from an earlier build do not linger. -->
  <Target Name="CopyWebApp" AfterTargets="Build" Condition="Exists('$(WebAppDist)\index.html')">
    <ItemGroup>
      <WebAppFile Include="$(WebAppDist)\**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(OutDir)wwwroot" Condition="Exists('$(OutDir)wwwroot')" />
    <Copy SourceFiles="@(WebAppFile)" DestinationFiles="@(WebAppFile->'$(OutDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <Target Name="CopyWebAppToPublish" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <Error Condition="'$(SkipWebBuild)' != 'true' And !Exists('$(WebAppDist)\index.html')"
           Text="The web app was not built at $(WebAppDist). Refusing to publish a controller without its web page." />
    <ItemGroup>
      <WebAppPublishFile Include="$(WebAppDist)\**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(PublishDir)wwwroot" Condition="Exists('$(PublishDir)wwwroot')" />
    <Copy SourceFiles="@(WebAppPublishFile)" DestinationFiles="@(WebAppPublishFile->'$(PublishDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" Condition="'@(WebAppPublishFile)' != ''" />
  </Target>

  <Target Name="CopyAppSettingsToPublish" AfterTargets="Publish">
    <ItemGroup>
      <AppSettingsFiles Include="$(MSBuildProjectDirectory)\appsettings.json" />
      <AppSettingsFiles Include="$(MSBuildProjectDirectory)\appsettings.example.json" />
    </ItemGroup>
    <Copy SourceFiles="@(AppSettingsFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="'@(AppSettingsFiles)' != '' And '$(PublishDir)' != ''" />
  </Target>

</Project>
