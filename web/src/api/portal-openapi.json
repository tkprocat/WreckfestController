  "components": {
    "schemas": {
      "AuthStateResponse": {
        "required": [
          "authenticated",
          "user",
          "setupRequired"
        ],
        "type": "object",
        "properties": {
          "authenticated": {
            "type": "boolean"
          },
          "user": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/UserResponse"
              }
            ]
          },
          "setupRequired": {
            "type": "boolean"
          }
        }
      },
      "ChangePasswordRequest": {
        "required": [
          "currentPassword",
          "newPassword"
        ],
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string"
          },
          "newPassword": {
            "type": "string"
          }
        }
      },
      "CreateUserRequest": {
        "required": [
          "password",
          "userName",
          "email"
        ],
        "type": "object",
        "properties": {
          "password": {
            "type": "string"
          },
          "userName": {
            "type": "string"
          },
          "isAdmin": {
            "type": "boolean"
          },
          "servers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "maxLength": 100,
            "minLength": 0,
            "type": [
              "null",
              "string"
            ]
          },
          "timeZone": {
            "maxLength": 64,
            "minLength": 0,
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "LoginRequest": {
        "required": [
          "login",
          "password"
        ],
        "type": "object",
        "properties": {
          "login": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "remember": {
            "type": "boolean"
          }
        }
      },
      "PortalPage": {
        "required": [
          "title",
          "intro",
          "servers"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "intro": {
            "type": [
              "null",
              "string"
            ]
          },
          "servers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServerCard"
            }
          }
        }
      },
      "ResetPasswordRequest": {
        "required": [
          "newPassword"
        ],
        "type": "object",
        "properties": {
          "newPassword": {
            "type": "string"
          }
        }
      },
      "ServerCard": {
        "required": [
          "id",
          "name",
          "description",
          "link",
          "state",
          "serverName",
          "humans",
          "bots",
          "maxPlayers",
          "currentTrack",
          "checkedAt",
          "lastSeenAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "link": {
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/ServerState"
          },
          "serverName": {
            "type": [
              "null",
              "string"
            ]
          },
          "humans": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "bots": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "maxPlayers": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "currentTrack": {
            "type": [
              "null",
              "string"
            ]
          },
          "checkedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "lastSeenAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "ServerState": {
        "enum": [
          "checking",
          "online",
          "server-stopped",
          "unreachable"
        ]
      },
      "UpdateProfileRequest": {
        "required": [
          "email"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "displayName": {
            "maxLength": 100,
            "minLength": 0,
            "type": [
              "null",
              "string"
            ]
          },
          "timeZone": {
            "maxLength": 64,
            "minLength": 0,
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "UpdateUserRequest": {
        "required": [
          "userName",
          "email"
        ],
        "type": "object",
        "properties": {
          "userName": {
            "type": "string"
          },
          "isAdmin": {
            "type": "boolean"
          },
          "servers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "maxLength": 100,
            "minLength": 0,
            "type": [
              "null",
              "string"
            ]
          },
          "timeZone": {
            "maxLength": 64,
            "minLength": 0,
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "UserResponse": {
        "required": [
          "id",
          "userName",
          "email",
          "displayName",
          "timeZone",
          "isAdmin",
          "servers",
          "isLockedOut",
          "lockoutEnd"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "userName": {
            "type": "string"
          },
          "email": {
            "type": [
              "null",
              "string"
            ]
          },
          "displayName": {
            "type": [
              "null",
              "string"
            ]
          },
          "timeZone": {
            "type": [
              "null",
              "string"
            ]
          },
          "isAdmin": {
            "type": "boolean"
          },
          "servers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "isLockedOut": {
            "type": "boolean"
          },
          "lockoutEnd": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      }
    }
