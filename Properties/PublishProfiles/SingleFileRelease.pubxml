<?xml version="1.0" encoding="utf-8"?>
<!--
This publish profile creates a single-file, self-contained executable.
No .NET runtime installation required on target machine.

To use:
- Visual Studio: Right-click project > Publish > Select "SingleFileRelease"
- Command line: dotnet publish -p:PublishProfile=SingleFileRelease
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\Publish\SingleFile\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>

    <!-- Target Windows x64 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- Self-contained: bundle .NET runtime -->
    <SelfContained>true</SelfContained>

    <!-- Single file: pack everything into one exe -->
    <PublishSingleFile>true</PublishSingleFile>

    <!-- Include native libraries in the single file -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>

    <!-- No debug symbols in release -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
